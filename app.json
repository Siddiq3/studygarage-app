{
  "expo": {
    "name": "StudyGarage",
    "slug": "10th_class",
    "version": "3.1.0",
    "orientation": "portrait",
    "icon": "./assets/branding/final-logo-pack/sg-mint-purple-1024-dark.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/sg-dark.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0C10"
    },
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "siddiqkolimidev.tenthApp"
    },
    "android": {
      "package": "siddiqkolimidev.tenth_app",
      "versionCode": 268,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/final-logo-pack/sg-mint-purple-1024-transparent.png",
        "backgroundColor": "#0B0C10"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f83019ec-3317-4507-b84f-afa2a768ccac"
      }
    },
    "runtimeVersion": "3.1.0",
    "scheme": "10th_class",
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ]
  }
}
