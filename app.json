{
  "expo": {
    "name": "StudyGarage",
    "slug": "10th_class",
    "version": "3.2.0",
    "orientation": "portrait",
    "icon": "./assets/branding/chalk/icon-1024.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/branding/chalk/native-splash-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#14342A"
    },
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "siddiqkolimidev.tenthApp"
    },
    "android": {
      "package": "siddiqkolimidev.tenth_app",
      "versionCode": 270,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/chalk/adaptive-foreground-1024.png",
        "backgroundColor": "#14342A"
      }
    },
    "web": {
      "favicon": "./assets/branding/chalk/favicon-96.png"
    },
    "extra": {
      "eas": {
        "projectId": "f83019ec-3317-4507-b84f-afa2a768ccac"
      }
    },
    "runtimeVersion": "3.2.0",
    "scheme": "10th_class",
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ]
  }
}
